{
	"name": "team8-frontend",
	"version": "1.0.0",
	"description": "Team8 Frontend",
	"main": "./dist/index.js",
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ui": "playwright test",
		"test:ui:headed": "playwright test --headed",
		"test:ui:report": "playwright show-report",
		"test:ui:typecheck": "tsc -p e2e/tsconfig.json",
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node ./dist/index.js",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"lint:format": "biome format --write ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kainos-academy-2026-gdansk/team8-frontend.git"
	},
	"keywords": [],
	"type": "commonjs",
	"bugs": {
		"url": "https://github.com/kainos-academy-2026-gdansk/team8-frontend/issues"
	},
	"homepage": "https://github.com/kainos-academy-2026-gdansk/team8-frontend#readme",
	"dependencies": {
		"axios": "^1.19.0",
		"axios-date-transformer": "^1.2.1",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-session": "^1.19.0",
		"govuk-frontend": "^6.4.0",
		"morgan": "^1.11.0",
		"nunjucks": "^3.2.4",
		"winston": "^3.19.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@playwright/test": "^1.62.1",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.1.2",
		"@types/nunjucks": "^3.2.6",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^4.1.10",
		"playwright-bdd": "^9.2.0",
		"supertest": "^7.2.2",
		"tsx": "^4.23.7",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"vitest": {
		"environment": "node"
	}
}
