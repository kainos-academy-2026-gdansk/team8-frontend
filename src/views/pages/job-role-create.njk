{% extends "layouts/base.njk" %}

{% block title %}Add job role{% endblock %}

{% block content %}
  <h1 class="govuk-heading-l">Add job role</h1>

  {% if backendError %}
    <div class="govuk-error-summary" role="alert" tabindex="-1">
      <h2 class="govuk-error-summary__title">There is a problem</h2>
      <div class="govuk-error-summary__body"><p class="govuk-body">{{ backendError }}</p></div>
    </div>
  {% endif %}

  {% if errorList.length > 0 %}
    <div class="govuk-error-summary" role="alert" tabindex="-1">
      <h2 class="govuk-error-summary__title">There is a problem</h2>
      <ul class="govuk-list govuk-error-summary__list">
        {% for item in errorList %}
          <li><a href="#{{ item.field }}">{{ item.message }}</a></li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  <form method="post" action="/job-roles/new" novalidate>
    {% for field in textFields %}
      <div class="govuk-form-group{% if errors[field.name] %} govuk-form-group--error{% endif %}">
        <label class="govuk-label" for="{{ field.name }}">{{ field.label }}</label>
        {% if errors[field.name] %}<p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> {{ errors[field.name] }}</p>{% endif %}
        {% if field.textarea %}
          <textarea class="govuk-textarea" id="{{ field.name }}" name="{{ field.name }}" rows="4">{{ values[field.name] or '' }}</textarea>
        {% else %}
          <input class="govuk-input" id="{{ field.name }}" name="{{ field.name }}" type="{{ field.type or 'text' }}" value="{{ values[field.name] or '' }}">
        {% endif %}
      </div>
    {% endfor %}

    <div class="govuk-form-group{% if errors.capabilityId %} govuk-form-group--error{% endif %}">
      <label class="govuk-label" for="capabilityId">Capability</label>
      {% if errors.capabilityId %}<p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> {{ errors.capabilityId }}</p>{% endif %}
      <select class="govuk-select" id="capabilityId" name="capabilityId">
        <option value="">Select a capability</option>
        {% for option in capabilities %}<option value="{{ option.id }}"{% if values.capabilityId == option.id %} selected{% endif %}>{{ option.name }}</option>{% endfor %}
      </select>
    </div>

    <div class="govuk-form-group{% if errors.bandId %} govuk-form-group--error{% endif %}">
      <label class="govuk-label" for="bandId">Band</label>
      {% if errors.bandId %}<p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> {{ errors.bandId }}</p>{% endif %}
      <select class="govuk-select" id="bandId" name="bandId">
        <option value="">Select a band</option>
        {% for option in bands %}<option value="{{ option.id }}"{% if values.bandId == option.id %} selected{% endif %}>{{ option.name }}</option>{% endfor %}
      </select>
    </div>

    <div class="govuk-form-group{% if errors.closingDate %} govuk-form-group--error{% endif %}">
      <label class="govuk-label" for="closingDate">Closing date</label>
      {% if errors.closingDate %}<p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> {{ errors.closingDate }}</p>{% endif %}
      <input class="govuk-input govuk-input--width-10" id="closingDate" name="closingDate" type="date" value="{{ values.closingDate or '' }}">
    </div>

    <div class="govuk-form-group{% if errors.numberOfOpenPositions %} govuk-form-group--error{% endif %}">
      <label class="govuk-label" for="numberOfOpenPositions">Number of open positions</label>
      {% if errors.numberOfOpenPositions %}<p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> {{ errors.numberOfOpenPositions }}</p>{% endif %}
      <input class="govuk-input govuk-input--width-5" id="numberOfOpenPositions" name="numberOfOpenPositions" type="number" min="0" value="{{ values.numberOfOpenPositions or '' }}">
    </div>

    <button class="govuk-button" type="submit">Create job role</button>
    <a class="govuk-link govuk-!-margin-left-3" href="/job-roles">Cancel</a>
  </form>
{% endblock %}
