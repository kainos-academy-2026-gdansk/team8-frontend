{% extends "layouts/base.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% block title %}{{ job.roleName }}{% endblock %}

{% block content %}
  <a class="govuk-back-link" href="/job-roles">Back to job roles</a>

  <article class="job-role-detail">
    <header class="job-role-detail__header">
      <h1 class="govuk-heading-l job-role-detail__title">{{ job.roleName }}</h1>
      <strong class="govuk-tag job-role-detail__status {% if job.status.name == 'OPEN' %}job-role-detail__status--open{% else %}job-role-detail__status--closed{% endif %}">
        {{ job.statusLabel }}
      </strong>
    </header>

    <p class="govuk-body-l job-role-detail__location">{{ job.location }}</p>

    <p class="govuk-body job-role-detail__meta">
      <span class="job-role-detail__meta-item">{{ job.capability.name }}</span>
      <span class="job-role-detail__meta-divider" aria-hidden="true">&bull;</span>
      <span class="job-role-detail__meta-item">{{ job.band.name }}</span>
    </p>

    <dl class="govuk-body job-role-detail__facts">
      <div class="job-role-detail__fact">
        <dt>Closing date</dt>
        <dd>{{ job.closingDateLabel }}</dd>
      </div>
      <div class="job-role-detail__fact">
        <dt>Open positions</dt>
        <dd>{{ job.numberOfOpenPositions }}</dd>
      </div>
    </dl>

    <section class="job-role-detail__section" aria-labelledby="description-heading">
      <h2 class="govuk-heading-m" id="description-heading">Description</h2>
      <p class="govuk-body">{{ job.description }}</p>
    </section>

    {% if job.responsibilities.length > 0 %}
    <section class="job-role-detail__section" aria-labelledby="responsibilities-heading">
      <h2 class="govuk-heading-m" id="responsibilities-heading">Key responsibilities</h2>
      <ul class="govuk-list govuk-list--bullet">
        {% for responsibility in job.responsibilities %}
          <li>{{ responsibility }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <div class="job-role-detail__actions">
      {% if canApply %}
      {{ govukButton({
        text: "Apply for this role",
        href: "/job-roles/" + job.id + "/applications/new"
      }) }}
      {% endif %}
    </div>

    {% if isAdmin %}
    <section class="job-role-detail__section job-role-applications" aria-labelledby="applications-heading">
      <h2 class="govuk-heading-m" id="applications-heading">Applications</h2>
      {% if job.applications.length > 0 %}
        <table class="govuk-table job-role-applications__table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th class="govuk-table__header job-role-applications__applicant" scope="col">Applicant</th>
              <th class="govuk-table__header job-role-applications__status-cell" scope="col">Status</th>
              <th class="govuk-table__header job-role-applications__actions-cell" scope="col">Actions</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for application in job.applications %}
              <tr class="govuk-table__row job-role-applications__row">
                <td class="govuk-table__cell job-role-applications__applicant">
                  <a class="govuk-link" href="{{ application.cv }}">{{ application.applicantEmail }}</a>
                </td>
                <td class="govuk-table__cell job-role-applications__status-cell">
                  <strong class="govuk-tag job-role-applications__status {% if application.status == 'IN_PROGRESS' %}job-role-applications__status--in-progress{% elif application.status == 'HIRED' %}job-role-applications__status--hired{% else %}job-role-applications__status--rejected{% endif %}">
                    {{ application.statusLabel }}
                  </strong>
                </td>
                <td class="govuk-table__cell job-role-applications__actions-cell">
                  {% if application.isInProgress %}
                    <div class="job-role-applications__actions">
                      <a class="govuk-button job-role-applications__action" href="{{ application.hireHref }}">Hire</a>
                      <a class="govuk-button govuk-button--warning job-role-applications__action" href="{{ application.rejectHref }}">Reject</a>
                    </div>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <p class="govuk-body job-role-applications__empty">No applications yet for this role.</p>
      {% endif %}
    </section>
    {% endif %}
  </article>
{% endblock %}
