{% extends "layouts/base.njk" %}

{% block title %}Sign in{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block content %}
	<section class="login-page">
		<div class="login-page__panel">
			<a href="/" class="govuk-back-link">Back</a>
			<h1 class="govuk-heading-l login-page__title">Sign in</h1>
			<p class="govuk-body login-page__intro">
				Use your account details to continue.
			</p>

			{% if errorMessage %}
				<div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" tabindex="-1" aria-labelledby="login-error-title">
					<h2 class="govuk-error-summary__title" id="login-error-title">There is a problem</h2>
					<div class="govuk-error-summary__body">
						<ul class="govuk-list govuk-error-summary__list">
							<li><a href="#email">{{ errorMessage }}</a></li>
						</ul>
					</div>
				</div>
			{% endif %}

			<form action="/login" method="post" novalidate class="login-form">
				<div class="govuk-form-group">
					<label class="govuk-label govuk-label--m" for="email">Email</label>
					<input
						class="govuk-input govuk-!-width-two-thirds"
						id="email"
						name="email"
						type="email"
						autocomplete="email"
						spellcheck="false"
						value="{{ formValues.email | default('', true) }}"
					/>
				</div>

				<div class="govuk-form-group">
					<label class="govuk-label govuk-label--m" for="password">Password</label>
					<input
						class="govuk-input govuk-!-width-two-thirds"
						id="password"
						name="password"
						type="password"
						autocomplete="current-password"
					/>
				</div>

				<button type="submit" class="govuk-button" data-module="govuk-button">
					Sign in
				</button>
			</form>

			<p class="govuk-body login-page__register-link">
				Do not have an account? <a class="govuk-link" href="/register">Create one</a>.
			</p>
		</div>
	</section>
{% endblock %}