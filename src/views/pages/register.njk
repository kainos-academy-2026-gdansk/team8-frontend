{% extends "layouts/base.njk" %}

{% block title %}Register{% endblock %}

{% block content %}
	<section class="register-page">
		<div class="register-page__panel">
			<h1 class="govuk-heading-l register-page__title">Create your account</h1>
			<p class="govuk-body register-page__intro">
				Register with your work email to continue.
			</p>

			{% if backendError %}
				<div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" tabindex="-1" aria-labelledby="register-backend-error-title">
					<h2 class="govuk-error-summary__title" id="register-backend-error-title">Unable to create account</h2>
					<div class="govuk-error-summary__body">
						<p class="govuk-body">{{ backendError }}</p>
					</div>
				</div>
			{% endif %}

			{% if errors and errorList and errorList.length > 0 %}
				<div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" tabindex="-1" aria-labelledby="register-error-title">
					<h2 class="govuk-error-summary__title" id="register-error-title">There is a problem</h2>
					<div class="govuk-error-summary__body">
						<ul class="govuk-list govuk-error-summary__list">
							{% for item in errorList %}
								<li>
									<a href="#{{ item.field }}">{{ item.message }}</a>
								</li>
							{% endfor %}
						</ul>
					</div>
				</div>
			{% endif %}

			{% if successMessage %}
				<div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="register-success-title" data-module="govuk-notification-banner">
					<div class="govuk-notification-banner__header">
						<h2 class="govuk-notification-banner__title" id="register-success-title">
							Success
						</h2>
					</div>
					<div class="govuk-notification-banner__content">
						<p class="govuk-notification-banner__heading">{{ successMessage }}</p>
					</div>
				</div>
			{% endif %}

			<form action="/register" method="post" novalidate class="register-form">
				<div class="govuk-form-group {% if errors and errors.email %}govuk-form-group--error{% endif %}">
					<label class="govuk-label govuk-label--m" for="email">Email</label>
					<p class="govuk-hint" id="email-hint">Use your company email address.</p>
					{% if errors and errors.email %}
						<p id="email-error" class="govuk-error-message">
							<span class="govuk-visually-hidden">Error:</span> {{ errors.email }}
						</p>
					{% endif %}
					<input
						class="govuk-input govuk-!-width-two-thirds"
						id="email"
						name="email"
						type="email"
						autocomplete="email"
						spellcheck="false"
						value="{{ values.email | default('', true) }}"
						{% if errors and errors.email %}aria-describedby="email-hint email-error"{% else %}aria-describedby="email-hint"{% endif %}
					/>
				</div>

				<div class="govuk-form-group {% if errors and errors.password %}govuk-form-group--error{% endif %}">
					<label class="govuk-label govuk-label--m" for="password">Password</label>
					<p class="govuk-hint" id="password-hint">Must be 8+ characters and include uppercase, lowercase, and a special character.</p>
					{% if errors and errors.password %}
						<p id="password-error" class="govuk-error-message">
							<span class="govuk-visually-hidden">Error:</span> {{ errors.password }}
						</p>
					{% endif %}
					<input
						class="govuk-input govuk-!-width-two-thirds"
						id="password"
						name="password"
						type="password"
						autocomplete="new-password"
						{% if errors and errors.password %}aria-describedby="password-hint password-error"{% else %}aria-describedby="password-hint"{% endif %}
					/>
				</div>

				<div class="govuk-form-group {% if errors and errors.confirmPassword %}govuk-form-group--error{% endif %}">
					<label class="govuk-label govuk-label--m" for="confirmPassword">Confirm password</label>
					{% if errors and errors.confirmPassword %}
						<p id="confirmPassword-error" class="govuk-error-message">
							<span class="govuk-visually-hidden">Error:</span> {{ errors.confirmPassword }}
						</p>
					{% endif %}
					<input
						class="govuk-input govuk-!-width-two-thirds"
						id="confirmPassword"
						name="confirmPassword"
						type="password"
						autocomplete="new-password"
						{% if errors and errors.confirmPassword %}aria-describedby="confirmPassword-error"{% endif %}
					/>
				</div>

				<button type="submit" class="govuk-button" data-module="govuk-button">
					Create account
				</button>
			</form>
		</div>
	</section>
{% endblock %}
