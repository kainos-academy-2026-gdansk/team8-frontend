{% extends "layouts/base.njk" %}

{% block title %}Apply for {{ roleId }}{% endblock %}

{% block content %}
  <a class="govuk-back-link" href="/job-roles/{{ roleId }}">Back to job role</a>
  <h1 class="govuk-heading-l">Apply for this role</h1>
  <p class="govuk-body">Tell us about your experience and suitability for this role.</p>

  {% if backendError %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" tabindex="-1" aria-labelledby="application-backend-error-title">
      <h2 class="govuk-error-summary__title" id="application-backend-error-title">There is a problem</h2>
      <div class="govuk-error-summary__body"><p class="govuk-body">{{ backendError }}</p></div>
    </div>
  {% endif %}

  {% if errorList.length > 0 %}
    <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" tabindex="-1" aria-labelledby="application-error-title">
      <h2 class="govuk-error-summary__title" id="application-error-title">There is a problem</h2>
      <div class="govuk-error-summary__body">
        <ul class="govuk-list govuk-error-summary__list">
          {% for item in errorList %}<li><a href="#{{ item.field }}">{{ item.message }}</a></li>{% endfor %}
        </ul>
      </div>
    </div>
  {% endif %}

  <form method="post" action="/job-roles/{{ roleId }}/applications/new" novalidate class="job-application-form">
    <div class="govuk-form-group {% if errors.cv %}govuk-form-group--error{% endif %}">
      <label class="govuk-label govuk-label--m" for="cv">CV</label>
      <p class="govuk-hint" id="cv-hint">Enter your CV as text, including your relevant experience and skills.</p>
      {% if errors.cv %}<p id="cv-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> {{ errors.cv }}</p>{% endif %}
      <textarea class="govuk-textarea" id="cv" name="cv" rows="15" aria-describedby="cv-hint{% if errors.cv %} cv-error{% endif %}">{{ values.cv }}</textarea>
    </div>
    <button type="submit" class="govuk-button" data-module="govuk-button">Submit application</button>
  </form>
{% endblock %}
