<!DOCTYPE html>
<html lang="en" class="govuk-template app-page">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% block title %}JobRoles{% endblock %} - Kainos</title>
    <link rel="stylesheet" href="/govuk-frontend.min.css" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="govuk-template__body app-page__body">
    <script>
      document.body.className += " js-enabled";
    </script>

    {% block header %}
      {% include "partials/header.njk" %}
    {% endblock %}

    <div class="govuk-width-container app-page__content">
      <main class="govuk-main-wrapper app-page__main" id="main-content" role="main">
        {% block content %}{% endblock %}
      </main>
    </div>

    {% block footer %}
      {% include "partials/footer.njk" %}
    {% endblock %}

    <script type="module">
      import { initAll } from "/govuk-frontend.min.js";
      initAll();
    </script>
  </body>
</html>